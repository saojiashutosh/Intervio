# PRODUCTION ONLY (used by docker-compose.yml on the maintainer's server).
# Contributors: do not copy this file. Local development uses docker-compose.dev.yml,
# which starts its own Postgres container and needs no DATABASE_URL.
#
# Copy to backend/.env on the server and fill in. Never commit backend/.env.

# Neon connection string (Dashboard > Connect). Keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=api.intervio.co.in
CSRF_TRUSTED_ORIGINS=https://api.intervio.co.in
# Where the frontend is served from (no trailing slash)
CORS_ALLOWED_ORIGINS=https://app.intervio.co.in
